config_version=5

[application]
config/name="Pushbox · Sand & Water"
run/main_scene="res://pushbox/scenes/main.tscn"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720

window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[physics]
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=2

[threading]
worker_pool/max_threads=1

[debug]
file_logging/enable_file_logging=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.09411765, 0.07843137, 0.14509804, 1)
viewport/hdr_2d=false
