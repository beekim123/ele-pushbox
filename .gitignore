.DS_Store
.godot/
__pycache__/
*.py[cod]
*.uid
.env
.env.*
node_modules/
# Local scratch output of the art tools (reviewable exports live in art/export/).
/art/.tmp/
# Keep the licensed macOS arm64 SDK runtime only.
*.dylib
!/third_party/ele-sdk/libele_godot.dylib
/builds/
# Reproducible test oracle; generated by the workbench reference exporter.
/game/tests/refs/workbench.reference.json
/game/tests/results/

# Godot import sidecars for generated/test outputs are recreated locally.
/game/generated/**/*.import
/game/reports/**/*.import
/game/bin/*.import

# Runtime copies are recreated from licensed third_party inputs by the launch/import tools.
/game/bin/
