; PORTITOR runtime. Run the resource importer before opening this project.
config_version=5

[application]
config/name="PORTITOR"
run/main_scene="res://app/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Registry="*res://app/autoload/registry.gd"
Events="*res://app/autoload/events.gd"
Save="*res://app/autoload/save.gd"
Locale="*res://app/autoload/locale.gd"
Settings="*res://app/autoload/settings.gd"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.094, 0.078, 0.145, 1)

[threading]
worker_pool/max_threads=1
